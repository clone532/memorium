<head>
  <meta charset="UTF-8">
  <title><%= titulo %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/x-icon" href="/IMGS/gallery/favicon.ico">
  <link rel="shortcut icon" type="image/x-icon" href="/IMGS/gallery/favicon.ico">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    html, body {
      height: 100%;
      height: 100dvh;
      margin: 0;
      overflow: hidden;
    }
    body {
      display: flex;
      flex-direction: column;
    }
    body,
    body.bg-light {
      background-color: #fff !important;
    }
    .navbar {
      flex-shrink: 0;
    }
    .d-flex {
      flex-grow: 1;
      overflow: hidden;
    }
    body > .d-flex {
      flex: 1 1 0;
      height: 0;
      min-height: 0;
      max-height: 100%;
    }
    body > .d-flex > .sidebar {
      height: auto;
      min-height: 0;
      align-self: stretch;
    }
    body > .d-flex > .content {
      min-height: 0;
    }
    .sidebar {
      width: 250px;
      flex: 0 0 250px;
      border: 0 !important;
      position: fixed;
      top: 56px;
      bottom: 0;
      left: 0;
      z-index: 1020;
      height: auto;
      max-height: none;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      transition: margin-left 0.3s ease;
    }
    .sidebar.bg-light {
      background: #21102e url("/IMGS/gallery/sidebar.png") center center / cover no-repeat !important;
    }
    .sidebar,
    .sidebar .text-black,
    .sidebar .nav-link {
      color: #f8f5ff !important;
    }
    body > .d-flex > .sidebar ~ .content,
    body > .d-flex > .sidebar ~ main {
      margin-left: 250px;
      transition: margin-left 0.3s ease;
    }
    body > .d-flex > .sidebar.hidden ~ .content,
    body > .d-flex > .sidebar.hidden ~ main {
      margin-left: 0;
    }
      body.sidebar-hidden > .d-flex > .sidebar ~ main {
      margin-left: 0;
    }
    .sidebar > .sidebar-plans {
      width: 100%;
      margin-top: auto;
    }
    .sidebar.hidden { margin-left: -250px; }
    .sidebar .nav-link {
      border-radius: 6px;
      transition: background-color 0.2s ease, color 0.2s ease;
    }
    .sidebar .nav-link:hover,
    .sidebar .nav-link:focus-visible {
      background-color: #6b0d79;
      color: #fff;
    }
    .content {
      flex-grow: 1;
      min-width: 0;
      padding: 20px;
      overflow-y: auto;
      height: 100%;
    }
    /* consistencia global */
    .card { border-radius: 1rem; }
    .form-control, .btn { border-radius: .6rem; }
    .password-field {
      position: relative;
      width: 100%;
    }
    .password-field > input {
      padding-right: 46px;
    }
    .password-toggle {
      position: absolute;
      top: 50%;
      right: 8px;
      width: 34px;
      height: 34px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: #6c757d;
      transform: translateY(-50%);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }
    .password-toggle:hover,
    .password-toggle:focus-visible {
      background: #eee8f7;
      color: #54208f;
      outline: 0;
    }
  </style>

  <script>
    (() => {
      const adicionarBotaoSenha = (raiz = document) => {
        const campos = [];
        if (raiz instanceof HTMLInputElement && raiz.type === 'password') {
          campos.push(raiz);
        }
        campos.push(...raiz.querySelectorAll('input[type="password"]'));

        campos.forEach((campo) => {
          if (campo.closest('.password-field')) return;

          const container = document.createElement('div');
          container.className = 'password-field';
          const botao = document.createElement('button');
          botao.type = 'button';
          botao.className = 'password-toggle';
          botao.setAttribute('aria-label', 'Mostrar senha');
          botao.title = 'Mostrar senha';
          botao.innerHTML = '<i class="bi bi-eye" aria-hidden="true"></i>';

          campo.parentNode.insertBefore(container, campo);
          container.append(campo, botao);
          botao.addEventListener('click', () => {
            const mostrar = campo.type === 'password';
            campo.type = mostrar ? 'text' : 'password';
            botao.setAttribute('aria-label', mostrar ? 'Ocultar senha' : 'Mostrar senha');
            botao.title = mostrar ? 'Ocultar senha' : 'Mostrar senha';
            botao.innerHTML = mostrar
              ? '<i class="bi bi-eye-slash" aria-hidden="true"></i>'
              : '<i class="bi bi-eye" aria-hidden="true"></i>';
            campo.focus();
          });
        });
      };

      const iniciar = () => {
        adicionarBotaoSenha();
        new MutationObserver((mutacoes) => {
          mutacoes.forEach((mutacao) => {
            mutacao.addedNodes.forEach((no) => {
              if (no instanceof HTMLElement) adicionarBotaoSenha(no);
            });
          });
        }).observe(document.documentElement, { childList: true, subtree: true });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', iniciar);
      } else {
        iniciar();
      }
    })();
  </script>
</head>
