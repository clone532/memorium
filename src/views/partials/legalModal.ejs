<style>
  .legal-document-dialog {
    position: fixed;
    inset: 0;
    width: min(920px, calc(100vw - 32px));
    max-height: 82vh;
    margin: auto;
    padding: 0;
    border: 1px solid #41495a;
    border-radius: 16px;
    background: #26062d;
    color: #f4f5f8;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
  }

  .legal-document-dialog::backdrop {
    background: rgba(20, 10, 28, 0.78);
  }

  .legal-document-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    padding: 8px 12px 8px 18px;
    border-bottom: 1px solid #41495a;
  }

  .legal-document-dialog-header h2 {
    margin: 0;
    color: inherit;
    font-size: 16px;
  }

  .legal-document-dialog-close {
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    font-size: 26px;
    line-height: 1;
  }

  .legal-document-dialog iframe {
    display: block;
    width: 100%;
    height: min(70vh, 700px);
    border: 0;
    border-radius: 0 0 16px 16px;
    background: #fff;
  }
</style>

<dialog class="legal-document-dialog" id="legalDocumentDialog" aria-labelledby="legalDocumentDialogTitle">
  <div class="legal-document-dialog-header">
    <h2 id="legalDocumentDialogTitle">Documento</h2>
    <button type="button" class="legal-document-dialog-close" aria-label="Fechar">&times;</button>
  </div>
  <iframe title="Documento legal" src="about:blank"></iframe>
</dialog>

<script>
  (() => {
    const dialog = document.getElementById('legalDocumentDialog');
    if (!dialog) return;

    const iframe = dialog.querySelector('iframe');
    const title = document.getElementById('legalDocumentDialogTitle');
    const closeButton = dialog.querySelector('.legal-document-dialog-close');

    document.querySelectorAll('a[href="/termos"], a[href="/privacidade"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const isTerms = new URL(link.href).pathname === '/termos';
        title.textContent = isTerms ? 'Termos de Uso' : 'Aviso de Privacidade';
        iframe.title = title.textContent;
        iframe.src = link.href;

        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        } else {
          window.open(link.href, '_blank', 'noopener,noreferrer');
        }
      });
    });

    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      iframe.src = 'about:blank';
    });
  })();
</script>
