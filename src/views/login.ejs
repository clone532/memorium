<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Memorium | Acesse sua conta</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root {
      color-scheme: dark;
      --panel: #26062d;
      --field: #3a2844;
      --line: #30394a;
      --muted: #a6adba;
      --accent: #9250ec;
    }

    * {
      box-sizing: border-box;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      min-height: 100svh;
      margin: 0;
      padding: 24px 16px;
      background: url("/IMGS/gallery/background.png") center center / cover no-repeat, #eee5f7;
      color: #f4f5f8;
      font-family: Arial, sans-serif;
    }

    .form-container {
      width: 100%;
      max-width: 372px;
      padding: 20px 22px 14px;
      border: 1px solid #41495a;
      border-radius: 21px;
      background: var(--panel) !important;
      box-shadow: 0 10px 30px rgba(35, 24, 49, 0.2);
    }

    .brand {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
    }

    .brand h1 {
      margin: 0;
      color: #f7f7fa;
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 28px;
      font-weight: 700;
    }

    .brand-subtitle {
      margin: 5px 0 0;
      color: #bbaccb;
      font-size: 13px;
      text-align: center;
    }

    .nav-tabs {
      display: flex;
      margin: 0 0 7px;
      border-bottom: 1px solid var(--line);
    }

    .nav-tabs .nav-item {
      flex: 1;
      text-align: center;
    }

    .nav-tabs .nav-link {
      width: 100%;
      padding: 8px 12px 7px;
      border: 0;
      border-bottom: 3px solid transparent;
      border-radius: 0;
      background: transparent;
      color: #969eac;
      font-size: 14px;
    }

    .nav-tabs .nav-link:hover {
      color: #e1d5f7;
    }

    .nav-tabs .nav-link.active {
      border-bottom-color: var(--accent);
      background: transparent;
      color: var(--accent);
      font-weight: 600;
    }

    .form-label {
      margin-bottom: 5px;
      color: #dbd1e0;
      font-size: 14px;
    }

    .form-control {
      min-height: 43px;
      padding: 9px 12px;
      border: 1px solid transparent;
      border-radius: 9px;
      background: var(--field);
      color: #f4f5f8;
      font-size: 14px;
    }

    .form-control::placeholder {
      color: #624b6f;
      opacity: 1;
    }

    .form-control:focus {
      border-color: #8250d5;
      background: var(--field);
      color: #fff;
      box-shadow: 0 0 0 3px rgba(146, 80, 236, 0.18);
    }

    .form-control::-webkit-calendar-picker-indicator {
      filter: invert(1);
    }

    .mb-3 {
      margin-bottom: 9px !important;
    }

    .btn-submit {
      min-height: 40px;
      margin-top: 5px;
      border: 0;
      border-radius: 8px;
      background: linear-gradient(105deg, #8250ed, #be47dc);
      color: #fff;
      font-size: 13px;
      font-weight: 600;
      transition: filter 160ms ease, transform 160ms ease;
    }

    .btn-submit:hover {
      filter: brightness(1.1);
      color: #fff;
      transform: translateY(-1px);
    }

    .forgot-password {
      margin: 7px 0 0;
      color: #d3d6de;
      font-size: 13px;
      text-align: center;
    }

    @media (max-width: 420px) {
      .form-container {
        padding: 18px 18px 14px;
      }

      .brand h1 {
        font-size: 26px;
      }
    }
  </style>
</head>

<body>
  <main class="form-container">
    <header>
      <div class="brand">
        <h1>Memorium</h1>
      </div>
      <p class="brand-subtitle">Entre na sua conta</p>
    </header>

    <ul class="nav nav-tabs" id="tabForm" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="login-tab" data-bs-toggle="tab" data-bs-target="#login" type="button"
          role="tab" aria-controls="login" aria-selected="true">Login</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="register-tab" data-bs-toggle="tab" data-bs-target="#register" type="button"
          role="tab" aria-controls="register" aria-selected="false">Cadastro</button>
      </li>
    </ul>
    <div class="tab-content">
      <div class="tab-pane fade show active" id="login" role="tabpanel" aria-labelledby="login-tab">
        <form method="POST" action="/usuario/logar">
          <div class="mb-3">
            <label for="loginEmail" class="form-label">Email</label>
            <input name="email" type="email" class="form-control" id="loginEmail" placeholder="exemplo@gmail.com" required>
          </div>
          <div class="mb-3">
            <label for="loginPassword" class="form-label">Senha</label>
            <input type="password" name="senha" class="form-control" id="loginPassword" required>
          </div>
          <button type="submit" class="btn btn-submit w-100">Entrar</button>
        </form>
        <p class="forgot-password">Esqueceu a senha?</p>
      </div>
      <div class="tab-pane fade" id="register" role="tabpanel" aria-labelledby="register-tab">
        <form method="post" action="/usuario/cadastrar">
          <div class="mb-3">
            <label for="registerName" class="form-label">Nome</label>
            <input type="text" name="nome" class="form-control" id="registerName" required>
          </div>
          <div class="mb-3">
            <label for="registerEmail" class="form-label">Email</label>
            <input type="email" name="email" class="form-control" id="registerEmail" required>
          </div>
          <div class="mb-3">
            <label for="registerPassword" class="form-label">Senha</label>
            <input type="password" name="senha" class="form-control" id="registerPassword" required>
          </div>
          <div class="mb-3">
            <label for="registerDataNasc" class="form-label">Data de Nascimento</label>
            <input type="date" name="dataNasc" class="form-control" id="registerDataNasc" required>
          </div>
          <button type="submit" class="btn btn-submit w-100">Cadastrar</button>
        </form>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <% if (mensagem) { %>

    <script>
      Swal.fire({
        toast: true,
        position: 'center',
        icon: '<%= mensagem.tipo %>',
        text: '<%= mensagem.valor %>',
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        backdrop: false
      });
    </script>

    <% } %>
</body>

</html>