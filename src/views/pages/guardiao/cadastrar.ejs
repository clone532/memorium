<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../../partials/head', { titulo: 'Cadastrar Guardião' }) %>
<%- include('../../partials/formataçãoFormulario') %>

<body class="bg-light">
  <%- include('../../partials/header') %>

  <div class="d-flex">
    <%- include('../../partials/sidebar') %>

    <main class="content">
      <div class="container-fluid py-3">
        <section class="config-page" aria-labelledby="guardiaoFormTitle">
          <header class="config-header">
            <span class="config-icon" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
            <div>
              <h1 id="guardiaoFormTitle">Cadastrar Guardião</h1>
              <p>Preencha os dados para cadastrar uma pessoa de confiança</p>
            </div>
          </header>

          <form class="config-form" action="/guardiao/cadastrar" method="post">
            <div class="config-field">
              <span class="field-icon" aria-hidden="true"><i class="bi bi-person-fill"></i></span>
              <div>
                <label for="guardiaoNome">Nome completo</label>
                <input class="form-control" type="text" id="guardiaoNome" name="nome" placeholder="Digite o nome completo" required>
              </div>
            </div>

            <div class="config-field">
              <span class="field-icon" aria-hidden="true"><i class="bi bi-envelope-fill"></i></span>
              <div>
                <label for="guardiaoEmail">E-mail</label>
                <input class="form-control" type="email" id="guardiaoEmail" name="email" placeholder="email@example.com" required>
              </div>
            </div>

            <div class="config-field">
              <span class="field-icon" aria-hidden="true"><i class="bi bi-telephone-fill"></i></span>
              <div>
                <label for="guardiaoNumero">Número de telefone</label>
                <input class="form-control" type="tel" id="guardiaoNumero" name="numero" placeholder="(00) 00000-0000" required>
              </div>
            </div>

            <div class="config-footer">
              <button type="submit" class="btn config-save">
                <i class="bi bi-person-plus-fill me-2" aria-hidden="true"></i>
                Cadastrar
              </button>
              <a href="/usuario/listar" class="btn config-secondary">Voltar</a>
            </div>
          </form>
        </section>
      </div>
    </main>
  </div>

  <%- include('../../partials/scripts') %>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <% if (mensagem) { %>
    <script>
      Swal.fire({
        toast: true,
        position: 'center',
        icon: '<%= mensagem.tipo %>',
        text: '<%= mensagem.valor %>',
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        backdrop: false
      });
    </script>
  <% } %>
</body>
</html>