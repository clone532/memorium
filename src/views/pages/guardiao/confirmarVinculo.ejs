<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../../partials/head', { titulo }) %>
<body class="bg-light">
  <main class="container py-5">
    <div class="card mx-auto shadow-sm" style="max-width: 36rem;">
      <div class="card-body p-4">
        <h1 class="h3 mb-3"><%= titulo %></h1>
        <% if (mensagem) { %>
          <p class="mb-0"><%= mensagem %></p>
        <% } else { %>
          <p><strong><%= guardiao.nomeGuardiao %></strong>, você foi indicado por
            <strong><%= guardiao.nomeUsuario %></strong> como guardião no Memorium.</p>
          <p>Ao confirmar, você poderá participar da confirmação de falecimento prevista pelo serviço.</p>
          <form method="post" action="/guardiao/vinculo/confirmar">
            <input type="hidden" name="token" value="<%= token %>">
            <button type="submit" class="btn btn-primary">Confirmar vínculo</button>
          </form>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>
