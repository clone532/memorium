<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../../partials/head', { titulo }) %>
<body class="bg-light">
  <main class="container py-5">
    <div class="card mx-auto shadow-sm" style="max-width: 36rem;">
      <div class="card-body p-4">
        <h1 class="h3 mb-3"><%= titulo %></h1>
        <% if (mensagem) { %>
          <p class="mb-0"><%= mensagem %></p>
        <% } else { %>
          <p><strong><%= guardiao.nomeGuardiao %></strong>, foi solicitado que você confirme o falecimento de
            <strong><%= guardiao.nomeUsuario %></strong>.</p>
          <p>Sua confirmação será contabilizada junto às confirmações de outros guardiões verificados.</p>
          <form method="post" action="/guardiao/falecimento/confirmar">
            <input type="hidden" name="token" value="<%= token %>">
            <button type="submit" class="btn btn-primary">Confirmar falecimento</button>
          </form>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>
