<!DOCTYPE html>
<html lang="pt-br">
<%- include('../../partials/head', { titulo: 'Destinatários' }) %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        .records-page {
            display: flex;
            flex-direction: column;
            width: 100%;
            max-width: none;
            min-height: 100%;
            margin: 0;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, .9);
            border-radius: 12px;
            background: rgba(255, 255, 255, .78);
            box-shadow: 0 8px 24px rgba(70, 42, 105, .07);
        }

        .records-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 12px 16px;
            border-bottom: 1px solid #eeeaf8;
        }

        .records-toolbar-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-record-create {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px 12px;
            border: 0;
            border-radius: 6px;
            background: #6541bd;
            color: #fff;
            font-size: 12px;
            text-decoration: none;
            white-space: nowrap;
        }

        .btn-record-create:hover {
            background: #52319e;
            color: #fff;
        }

        .records-heading {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .records-icon {
            display: grid;
            place-items: center;
            width: 38px;
            height: 38px;
            border-radius: 8px;
            background: #f0edff;
            color: #7047c5;
            font-size: 17px;
        }

        .records-heading h2 {
            margin: 0;
            color: #27243b;
            font-size: 20px;
            font-weight: 600;
        }

        .records-heading p {
            margin: 3px 0 0;
            color: #777487;
            font-size: 12px;
        }

        .records-search {
            display: flex;
            align-items: center;
            gap: 8px;
            width: min(300px, 45%);
            padding: 0 11px;
            border: 1px solid #e9e5f7;
            border-radius: 20px;
            background: #fbfaff;
            color: #7956ba;
        }

        .records-search input {
            width: 100%;
            min-width: 0;
            padding: 8px 0;
            border: 0;
            outline: 0;
            background: transparent;
            color: #332d48;
            font-size: 12px;
        }

        .records-table-wrap {
            flex: 1;
            overflow: auto;
            margin: 8px 12px 0;
            padding: 0;
            border: 1px solid #e9e5f7;
            border-radius: 10px;
            background: #fff;
        }

        .records-table {
            margin: 0;
            color: #343146;
            font-size: 13px;
        }

        .records-table thead th {
            padding: 9px 12px;
            border: 0;
            background: #f0edff;
            color: #48415f;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .records-table thead th:first-child {
            border-radius: 7px 0 0 7px;
        }

        .records-table thead th:last-child {
            border-radius: 0 7px 7px 0;
        }

        .records-table tbody td {
            padding: 7px 12px;
            border-color: #eeeaf7;
            vertical-align: middle;
        }

        .records-table tbody tr:hover {
            background: #faf9ff;
        }

        .records-table td:first-child {
            width: 48px;
            text-align: center;
            color: #716b83;
        }

        .record-actions {
            display: flex;
            gap: 6px;
            white-space: nowrap;
        }

        .record-actions .btn {
            min-width: 76px;
            padding: 4px 9px;
            border: 0;
            border-radius: 5px;
            color: #fff;
            font-size: 11px;
        }

        .btn-record-edit {
            background: #6541bd;
        }

        .btn-record-edit:hover {
            background: #52319e;
            color: #fff;
        }

        .btn-record-delete {
            background: #e53d5c;
        }

        .btn-record-delete:hover {
            background: #c72d49;
            color: #fff;
        }

        .empty-records {
            padding: 24px !important;
            color: #777487;
            text-align: center;
        }

        .records-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            min-height: 48px;
            margin: 8px;
            padding: 7px 12px;
            border-radius: 8px;
            background: #f5f3fc;
        }

        .records-summary {
            margin: 0;
            color: #666176;
            font-size: 11px;
        }

        .records-pagination {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .records-pagination button {
            min-width: 28px;
            height: 28px;
            padding: 0 8px;
            border: 0;
            border-radius: 50%;
            background: transparent;
            color: #665d7b;
            font-size: 11px;
        }

        .records-pagination button[aria-current="page"] {
            background: #7047c5;
            color: #fff;
        }

        .records-pagination button:disabled {
            opacity: .4;
        }

        @media (max-width: 640px) {
            .records-toolbar {
                align-items: stretch;
                flex-direction: column;
                gap: 12px;
            }

            .records-toolbar-actions {
                align-items: stretch;
                flex-direction: column;
            }

            .records-search {
                width: 100%;
            }

            .records-footer {
                align-items: flex-start;
                flex-direction: column;
            }

            .records-table {
                min-width: 650px;
            }
        }
    </style>

    <body class="bg-light">

        <%- include('../../partials/header') %>

            <div class="d-flex">
                <%- include('../../partials/sidebar') %>

                    <div class="content w-100">
                        <div class="container-fluid p-0">
                            <section class="records-page" aria-labelledby="destinatariosTitle">
                                <header class="records-toolbar">
                                    <div class="records-heading">
                                        <span class="records-icon" aria-hidden="true"><i
                                                class="bi bi-person-lines-fill"></i></span>
                                        <div>
                                            <h2 id="destinatariosTitle">Destinatários</h2>
                                            <p>Gerencie os destinatários cadastrados</p>
                                        </div>
                                    </div>
                                    <div class="records-toolbar-actions">
                                        <a href="/destinatario/cadastrar" class="btn-record-create"><i
                                                class="bi bi-person-plus-fill" aria-hidden="true"></i>Cadastrar
                                            destinatário</a>
                                        <label class="records-search">
                                            <i class="bi bi-search" aria-hidden="true"></i>
                                            <input id="destinatarioSearch" type="search"
                                                placeholder="Buscar por nome, email ou telefone..."
                                                aria-label="Buscar destinatários">
                                        </label>
                                    </div>
                                </header>
                                <div class="records-table-wrap">
                                    <table class="table records-table">
                                        <thead>
                                            <tr>
                                                <th scope="col">#</th>
                                                <th scope="col">Nome</th>
                                                <th scope="col">Email</th>
                                                <th scope="col">Telefone</th>
                                                <th scope="col">Ações</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (destinatarios && destinatarios.length) { %>
                                                <% destinatarios.forEach((destinatario, i)=> { %>
                                                    <tr class="destinatario-row">
                                                        <td>
                                                            <%= i + 1 %>
                                                        </td>
                                                        <td>
                                                            <%= destinatario.nome %>
                                                        </td>
                                                        <td>
                                                            <%= destinatario.email %>
                                                        </td>
                                                        <td>
                                                            <%= destinatario.numero %>
                                                        </td>
                                                        <td>
                                                            <div class="record-actions">
                                                                <form
                                                                    action="/destinatario/editar/<%= destinatario.id %>"
                                                                    method="get"><button type="submit"
                                                                        class="btn btn-record-edit"><i
                                                                            class="bi bi-pencil-fill me-1"
                                                                            aria-hidden="true"></i>Editar</button>
                                                                </form>
                                                                <form class="form-excluir"
                                                                    action="/destinatario/cadastrarListar/<%= destinatario.id %>"
                                                                    method="post"><button type="submit"
                                                                        class="btn btn-record-delete"><i
                                                                            class="bi bi-trash-fill me-1"
                                                                            aria-hidden="true"></i>Excluir</button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                                        <% } %>
                                                            <tr id="emptyDestinatarios" hidden>
                                                                <td class="empty-records" colspan="5">Nenhum
                                                                    destinatário encontrado.</td>
                                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <footer class="records-footer">
                                    <p class="records-summary" id="destinatarioSummary" aria-live="polite"></p>
                                    <nav class="records-pagination" id="destinatarioPagination"
                                        aria-label="Paginação dos destinatários"></nav>
                                </footer>
                            </section>
                        </div>
                    </div>
            </div>


            <%- include('../../partials/scripts') %>
                <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
                <script>
                    const destinatarioRows = Array.from(document.querySelectorAll('.destinatario-row'));
                    const destinatarioSearch = document.getElementById('destinatarioSearch');
                    const destinatarioSummary = document.getElementById('destinatarioSummary');
                    const destinatarioPagination = document.getElementById('destinatarioPagination');
                    const emptyDestinatarios = document.getElementById('emptyDestinatarios');
                    const pageSize = 12;
                    const visiblePageCount = 5;
                    let currentPage = 1;

                    function renderDestinatarioPage() {
                        const query = destinatarioSearch.value.trim().toLocaleLowerCase('pt-BR');
                        const filteredRows = destinatarioRows.filter((row) => row.textContent.toLocaleLowerCase('pt-BR').includes(query));
                        const pageCount = Math.max(1, Math.ceil(filteredRows.length / pageSize));
                        currentPage = Math.min(currentPage, pageCount);
                        const firstPage = Math.min(currentPage, Math.max(1, pageCount - visiblePageCount + 1));
                        const lastPage = Math.min(firstPage + visiblePageCount - 1, pageCount);
                        const firstVisible = (currentPage - 1) * pageSize;
                        const lastVisible = Math.min(firstVisible + pageSize, filteredRows.length);

                        destinatarioRows.forEach((row) => { row.hidden = true; });
                        filteredRows.slice(firstVisible, lastVisible).forEach((row) => { row.hidden = false; });
                        emptyDestinatarios.hidden = filteredRows.length > 0;
                        destinatarioSummary.textContent = filteredRows.length
                            ? `Mostrando ${firstVisible + 1} - ${lastVisible} de ${filteredRows.length} registros`
                            : 'Mostrando 0 de 0 registros';

                        destinatarioPagination.replaceChildren();
                        const addPageButton = (label, page, ariaLabel, isCurrent, isDisabled) => {
                            const button = document.createElement('button');
                            button.type = 'button';
                            button.innerHTML = label;
                            button.setAttribute('aria-label', ariaLabel);
                            button.disabled = isDisabled;
                            if (isCurrent) button.setAttribute('aria-current', 'page');
                            button.addEventListener('click', () => { currentPage = page; renderDestinatarioPage(); });
                            destinatarioPagination.appendChild(button);
                        };

                        if (firstPage > 1) addPageButton('<i class="bi bi-chevron-double-left"></i>', 1, 'Primeira página', false, false);
                        addPageButton('<i class="bi bi-chevron-left"></i>', currentPage - 1, 'Página anterior', false, currentPage === 1);
                        for (let page = firstPage; page <= lastPage; page += 1) addPageButton(String(page), page, `Página ${page}`, page === currentPage, false);
                        addPageButton('<i class="bi bi-chevron-right"></i>', currentPage + 1, 'Próxima página', false, currentPage === pageCount);
                        if (lastPage < pageCount) addPageButton('<i class="bi bi-chevron-double-right"></i>', pageCount, 'Última página', false, false);
                    }

                    destinatarioSearch.addEventListener('input', () => { currentPage = 1; renderDestinatarioPage(); });
                    renderDestinatarioPage();

                    const formsExcluir = document.getElementsByClassName('form-excluir');
                    for (const formExcluir of formsExcluir) {
                        formExcluir.addEventListener('submit', (e) => {
                            e.preventDefault();
                            Swal.fire({
                                title: 'Deseja realmente excluir?',
                                icon: 'warning',
                                backdrop: false,
                                showCancelButton: true,
                                confirmButtonText: 'Sim',
                                cancelButtonText: 'Cancelar'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    formExcluir.submit();
                                }
                            });
                        });
                    }

                    (function () {
                        const nameInput = document.querySelector('input[name="nome"]');
                        if (nameInput && nameInput.value) {
                            nameInput.focus();
                            nameInput.select();
                        }
                    })();
                </script>

                <% if (mensagem) { %>
                    <script>
                        Swal.fire({
                            toast: true,
                            position: 'center',
                            icon: '<%= mensagem.tipo %>',
                            text: '<%= mensagem.valor %>',
                            showConfirmButton: false,
                            timer: 3000,
                            timerProgressBar: true,
                            backdrop: false
                        });
                    </script>
                    <% } %>

    </body>

</html>