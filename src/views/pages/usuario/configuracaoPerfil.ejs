<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../../partials/head') %>
<%- include('../../partials/formataçãoFormulario') %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
  .list-heading h1 { margin: 0; color: #27243b; font-size: 20px; font-weight: 600; }
  .list-heading p { margin: 3px 0 0; color: #777487; font-size: 12px; }
</style>

<body class="bg-light">
  <%- include('../../partials/header') %>

  <div class="d-flex">
    <%- include('../../partials/sidebar') %>

    <main class="content">
      <section class="config-page">
        <header class="config-header">
          <span class="config-icon" aria-hidden="true"><i class="bi bi-person-fill"></i></span>
          <div>
            <h1>Configurações do Perfil</h1>
            <p>Atualize suas informações pessoais</p>
          </div>
        </header>

        <form class="config-form" action="/usuario/configuracaoPerfil" method="post">
          <div class="config-field">
            <span class="field-icon" aria-hidden="true"><i class="bi bi-person-fill"></i></span>
            <div>
              <label for="nome">Nome</label>
              <input class="form-control" type="text" name="nome" id="nome" value="<%= usuarioPerfil.nome %>">
            </div>
          </div>

          <div class="config-field">
            <span class="field-icon" aria-hidden="true"><i class="bi bi-envelope-fill"></i></span>
            <div>
              <label for="email">Email</label>
              <input class="form-control" type="email" name="email" id="email" value="<%= usuarioPerfil.email %>">
            </div>
          </div>

          <div class="config-field">
            <span class="field-icon" aria-hidden="true"><i class="bi bi-lock-fill"></i></span>
            <div>
              <label for="senha">Senha</label>
              <input class="form-control" type="password" name="senha" id="senha" value="<%= usuarioPerfil.senha %>">
            </div>
          </div>

          <div class="config-footer">
            <button type="submit" class="btn config-save"><i class="bi bi-floppy-fill me-2" aria-hidden="true"></i>Salvar</button>
          </div>
        </form>
      </section>
    </main>
  </div>

  <%- include('../../partials/scripts') %>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <% if (mensagem) { %>
    <script>
      Swal.fire({
        toast: true,
        position: 'center',
        icon: '<%= mensagem.tipo %>',
        text: '<%= mensagem.valor %>',
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        backdrop: false
      });
    </script>
  <% } %>
</body>
</html>