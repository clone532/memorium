<!DOCTYPE html>
<html lang="pt-br">
<%- include('../../partials/head') %>
    <%- include('../../partials/formataçãoFormulario') %>

        <style>
            :root {
                --perfil-bg: #fff;
                --perfil-primary: #6840b5;
                --perfil-primary-hover: #552e9d;
                --perfil-accent: #e8e1ff;
                --perfil-accent-soft: #f2efff;
                --perfil-ink: #27243b;
                --perfil-muted: #777487;
                --perfil-border: #eeeaf7;
            }

            .reference {
                color: #000000;
            }

            .reference:hover {
                color: #6840b5;
            }

            * {
                box-sizing: border-box;
            }

            html {
                height: auto;
                min-height: 100%;
                overflow-y: auto;
            }

            .botao-personalizado {
                font-family: inherit;
                font-weight: 600;
                line-height: 1.2;
                transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
            }

            .botao-personalizado:focus-visible {
                outline: 3px solid rgba(104, 64, 181, 0.35);
                outline-offset: 2px;
            }

            .botao-personalizado:disabled {
                cursor: not-allowed;
                opacity: 0.6;
            }

            body {
                margin: 0;
                height: auto;
                min-height: 100vh;
                overflow: visible;
                font-family: Arial, sans-serif;
                background: var(--perfil-bg);
                display: flex;
                flex-direction: column;
            }

            .padronizar-avatar {
                border-radius: 50%;
                width: 120px;
                height: 120px;
                background: var(--perfil-accent);
                object-fit: cover;
                flex-shrink: 0;
            }

            .padronizar-avatar-publi {
                border-radius: 50%;
                width: 30px;
                height: 30px;
                background: var(--perfil-accent);
                object-fit: cover;
                flex-shrink: 0;
            }

            .padronizar-avatar.bi-person-circle {
                font-size: 120px;
                line-height: 1;
            }

            .perfil-layout {
                display: flex;
                min-height: 0;
            }

            body>.perfil-layout {
                flex: 0 0 auto;
                overflow: visible;
            }

            .perfil-layout>.sidebar {
                position: fixed;
                top: 56px;
                bottom: 0;
                left: 0;
                align-self: stretch;
                height: auto;
                min-height: 0;
                overflow-y: auto;
            }

            .perfil-container {
                flex: 1;
                min-width: 0;
                min-height: calc(100vh - 56px);
                margin-left: 250px;
                background: var(--perfil-bg);
                padding: 40px 20px;
                transition: margin-left 0.3s ease;
            }

            .perfil-layout>.sidebar.hidden~.perfil-container {
                margin-left: 0;
            }

            .perfil-header {
                text-align: center;
                margin-bottom: 40px;
            }

            .botao-foto {
                position: absolute;
                right: -5px;
                bottom: -5px;
                width: 40px;
                height: 40px;
                border-radius: 50%;
                border: 3px solid white;
                background: var(--perfil-primary);
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                font-size: 18px;
            }

            .perfil-name {
                font-size: 32px;
                color: var(--perfil-ink);
                margin: 20px 0 15px;
                font-weight: 600;
            }

            .perfil-divider {
                width: 80%;
                height: 3px;
                background: linear-gradient(90deg,
                        transparent,
                        #8d68d2,
                        transparent);
                margin: 30px auto;
            }

            .perfil-tabs {
                display: flex;
                justify-content: center;
                gap: 20px;
                flex-wrap: wrap;
            }

            .perfil-tab {
                padding: 12px 45px;
                border: none;
                border-radius: 25px;
                background: var(--perfil-accent-soft);
                color: #5d5570;
                font-size: 16px;
                cursor: pointer;
                transition: 0.3s;
            }

            .perfil-tab:hover {
                background: var(--perfil-accent);
                color: var(--perfil-primary-hover);
                transform: translateY(-2px);
            }

            .perfil-tab.active {
                background: var(--perfil-primary);
                color: #fff;
                box-shadow: 0 4px 15px rgba(104, 64, 181, 0.2);
            }

            .perfil-content {
                max-width: 900px;
                margin: auto;
            }

            .perfil-section {
                display: none;
                animation: aparecer 0.3s ease;
            }

            .perfil-section.active {
                display: block;
            }

            .perfil-section h2 {
                color: var(--perfil-ink);
                margin-bottom: 20px;
            }
            
            .criar-biografia {
                background: transparent;
                border-radius: 15px;
                padding: 0;
                margin-bottom: 25px;
            }

            .campo-biografia {
                width: 100%;
                min-height: 100px;
                border: 1px solid #d8d2e9;
                border-radius: 12px;
                padding: 15px;
                resize: vertical;
                outline: none;
                font-size: 15px;
                box-sizing: border-box;
                background: white;
            }

            .campo-biografia:focus {
                border-color: #8d68d2;
                box-shadow: 0 0 0 3px rgba(141, 104, 210, 0.12);
            }

            .opcoes-biografia {
                display: flex;
                gap: 10px;
                margin-top: 15px;
                flex-wrap: wrap;
            }

            .opcao-arquivo {
                position: relative;
                border: none;
                background: var(--perfil-accent-soft);
                color: var(--perfil-primary);
                padding: 10px 16px;
                border-radius: 20px;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-weight: 600;
            }

            .opcao-arquivo input[type="file"] {
                position: absolute;
                width: 1px;
                height: 1px;
                padding: 0;
                margin: -1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                white-space: nowrap;
                border: 0;
            }

            .opcao-arquivo:hover {
                background: var(--perfil-accent);
            }

            .opcao-arquivo:focus-within {
                outline: 3px solid rgba(104, 64, 181, 0.25);
                outline-offset: 3px;
            }

            .arquivo-nome {
                color: var(--perfil-muted);
                font-size: 14px;
                margin-top: 10px;
            }

            .preview-biografia {
                margin-top: 15px;
                display: none;
            }

            .preview-biografia img,
            .preview-biografia video {
                max-width: 100%;
                max-height: 400px;
                border-radius: 12px;
            }

            .preview-biografia audio {
                width: 100%;
            }

            .botao-publicar {
                margin-top: 15px;
                width: 100%;
                border: none;
                background: var(--perfil-primary);
                color: white;
                padding: 12px;
                border-radius: 25px;
                font-size: 16px;
                cursor: pointer;
            }

            .botao-publicar:hover {
                background: var(--perfil-primary-hover);
            }

            /* PUBLICAÇÕES */

            .publicacao {
                background: white;
                border-radius: 15px;
                padding: 20px;
                margin-bottom: 20px;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            }

            .publicacao-header {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 15px;
            }

            .mini-avatar {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: var(--perfil-accent);
                color: #5d359d;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                flex-shrink: 0;
                overflow: hidden;
            }

            .mini-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            .publicacao-header strong {
                display: block;
                color: var(--perfil-ink);
            }

            .publicacao-header small {
                color: var(--perfil-muted);
            }

            .publicacao p {
                color: #39364c;
                line-height: 1.6;
                margin-bottom: 15px;
            }

            .publicacao-media {
                width: 100%;
                max-height: 500px;
                object-fit: contain;
                border-radius: 12px;
                margin-bottom: 15px;
                background: #f5f3fc;
            }

            .publicacao-audio {
                display: block;
                width: 100%;
                margin: 10px 0;
            }

            .publicacao-acoes {
                border-top: 1px solid var(--perfil-border);
                padding-top: 12px;
                display: flex;
                gap: 20px;
            }

            .botao-personalizado--acao {
                border: none;
                background: none;
                color: #666176;
                padding: 6px 10px;
                border-radius: 8px;
                cursor: pointer;
            }

            .botao-personalizado--acao:hover {
                background: var(--perfil-accent-soft);
                color: var(--perfil-primary);
            }

            /* MURAL */

            .mural-card {
                background: white;
                border-radius: 15px;
                padding: 20px;
                margin-bottom: 20px;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            }

            .mural-topo {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 20px;
            }

            .mural-topo strong {
                display: block;
                color: var(--perfil-ink);
            }

            .mural-topo small {
                color: var(--perfil-muted);
            }

            .mural-conteudo {
                background: var(--perfil-accent-soft);
                border-radius: 12px;
                padding: 20px;
            }

            .mural-conteudo p {
                color: #39364c;
                margin: 0;
                line-height: 1.6;
            }

            .mural-acoes {
                display: flex;
                gap: 20px;
                margin-top: 15px;
                padding-top: 12px;
                border-top: 1px solid var(--perfil-border);
            }

            .mural-texto {
                color: #39364c;
                line-height: 1.6;
            }

            .mural-comentario-form label {
                display: block;
                color: var(--perfil-ink);
                font-weight: 600;
            }

            .mural-comentario-form textarea {
                display: block;
                width: 100%;
                min-height: 110px;
                margin-top: 10px;
                padding: 12px 14px;
                border: 1px solid var(--perfil-border);
                border-radius: 12px;
                background: #fff;
                color: var(--perfil-ink);
                font: inherit;
                resize: vertical;
            }

            .mural-comentario-form textarea:focus {
                border-color: var(--perfil-primary);
                outline: 3px solid rgba(104, 64, 181, 0.15);
            }

            @keyframes aparecer {

                from {
                    opacity: 0;
                    transform: translateY(10px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }

            }

            @media (max-width: 768px) {

                .perfil-container {
                    padding: 30px 15px;
                }

                .perfil-name {
                    font-size: 24px;
                }

                .perfil-tab {
                    padding: 10px 30px;
                    font-size: 14px;
                }

                .perfil-divider {
                    width: 90%;
                }

            }
        </style>

        <body>
            <%- include('../../partials/header') %>
                <div class="perfil-layout">
                    <%- include('../../partials/sidebar') %>
                        <div class="perfil-container">
                            <div class="perfil-header">

                                <div class="d-flex justify-content-center">
                                    <% if (usuarioPerfil.imagem) { %>
                                        <img src="/uploads/<%= usuarioPerfil.imagem %>" class="padronizar-avatar">
                                        <% } else { %>
                                            <i class="bi bi-person-circle padronizar-avatar" aria-hidden="true"
                                                id="fotoPerfil"></i>
                                            <% } %>
                                </div>
                                <h1 class="perfil-name">
                                    <%= usuarioPerfil.nome %>
                                </h1>
                                <% if (ehProprioPerfil) { %>
                                    <a href="/usuario/configuracaoPerfil" class="reference">
                                        <i class="bi bi-gear"></i>
                                        <button class="btn botao-personalizado" type="button">
                                            configurações
                                        </button>
                                    </a>
                                <% } else if (usuario.tipo === 'ADMIN') { %>
                                    <a href="/usuario/editar/<%= usuarioPerfil.id %>" class="reference">
                                        <button class="btn botao-personalizado" type="button">Editar perfil</button>
                                    </a>
                                <% } %>

                                <div class="perfil-divider"></div>
                                <div class="perfil-tabs">
                                    <button class="perfil-tab botao-personalizado <%= abaInicial === 'biografia' ? 'active' : '' %>"
                                        onclick="mostrarAba('biografia', this)">
                                        Biografia
                                    </button>
                                    <button class="perfil-tab botao-personalizado <%= abaInicial === 'mural' ? 'active' : '' %>"
                                        onclick="mostrarAba('mural', this)">
                                        Mural
                                    </button>
                                </div>
                            </div>

                            <div class="perfil-content">
                                <div id="biografia" class="perfil-section <%= abaInicial === 'biografia' ? 'active' : '' %>">
                                    <h2>
                                        Biografia
                                    </h2>

                                    <% if (ehProprioPerfil) { %>
                                        <form id="formBiografia" class="criar-biografia"
                                            action="/perfilUsuario/perfil/<%= usuarioPerfil.id %>/biografia"
                                            method="post" enctype="multipart/form-data">
                                            <h3>
                                                <% if (usuario.imagem) { %>
                                                    <img src="/uploads/<%= usuario.imagem %>"
                                                        class="padronizar-avatar-publi" alt="">
                                                <% } else { %>
                                                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                                                <% } %>
                                                Criar publicação
                                            </h3>
                                            <textarea name="conteudo" id="textoBiografia" class="campo-biografia"
                                                maxlength="5000"
                                                placeholder="Compartilhe uma lembrança ou escreva algo..."></textarea>

                                            <div class="opcoes-biografia">
                                                <label class="opcao-arquivo" for="anexoUrl">
                                                    <i class="bi bi-image" aria-hidden="true"></i>
                                                    Escolher arquivo
                                                    <input type="file" id="anexoUrl" name="anexoUrl"
                                                        accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,audio/mpeg,audio/wav,audio/ogg">
                                                </label>
                                            </div>
                                            <div id="arquivoNome" class="arquivo-nome" aria-live="polite">
                                                Imagens, vídeos ou áudios (máximo 10 MB).
                                            </div>
                                            <div id="previewBiografia" class="preview-biografia"></div>
                                            <% if (mensagemBiografia) { %>
                                                <div class="alert alert-danger mt-3" role="alert">
                                                    <%= mensagemBiografia.valor %>
                                                </div>
                                            <% } %>
                                            <button type="submit" class="botao-publicar botao-personalizado">
                                                <i class="bi bi-send"></i>
                                                Publicar
                                            </button>
                                        </form>
                                    <% } %>

                                    <div id="listaBiografia">
                                        <% if (biografias.length === 0) { %>
                                            <p class="mural-texto">Ainda não há publicações nesta biografia.</p>
                                        <% } %>
                                        <% biografias.forEach((publicacao) => { %>
                                            <article class="publicacao">
                                                <div class="publicacao-header">
                                                    <div class="mini-avatar">
                                                        <% if (usuarioPerfil.imagem) { %>
                                                            <img src="/uploads/<%= usuarioPerfil.imagem %>" alt="">
                                                        <% } else { %>
                                                            <i class="bi bi-person"></i>
                                                        <% } %>
                                                    </div>
                                                    <div>
                                                        <strong><%= usuarioPerfil.nome %></strong>
                                                        <small><%= new Date(publicacao.data_hora).toLocaleString('pt-BR') %></small>
                                                    </div>
                                                </div>
                                                <% if (publicacao.conteudo) { %>
                                                    <p><%= publicacao.conteudo %></p>
                                                <% } %>
                                                <% if (publicacao.anexo_url && publicacao.tipo_anexo && publicacao.tipo_anexo.startsWith('image/')) { %>
                                                    <img class="publicacao-media" src="/uploads/<%= publicacao.anexo_url %>"
                                                        alt="Arquivo anexado à publicação">
                                                <% } else if (publicacao.anexo_url && publicacao.tipo_anexo && publicacao.tipo_anexo.startsWith('video/')) { %>
                                                    <video class="publicacao-media" controls preload="metadata">
                                                        <source src="/uploads/<%= publicacao.anexo_url %>" type="<%= publicacao.tipo_anexo %>">
                                                        Seu navegador não consegue reproduzir este vídeo.
                                                    </video>
                                                <% } else if (publicacao.anexo_url && publicacao.tipo_anexo && publicacao.tipo_anexo.startsWith('audio/')) { %>
                                                    <audio class="publicacao-audio" controls preload="metadata">
                                                        <source src="/uploads/<%= publicacao.anexo_url %>" type="<%= publicacao.tipo_anexo %>">
                                                        Seu navegador não consegue reproduzir este áudio.
                                                    </audio>
                                                <% } %>
                                            </article>
                                        <% }) %>
                                    </div>
                                </div>



                                <!-- ============================= -->
                                <!-- MURAL -->
                                <!-- ============================= -->

                                <div id="mural" class="perfil-section <%= abaInicial === 'mural' ? 'active' : '' %>">
                                    <h2>
                                        Mural
                                    </h2>
                                    <% if (mensagem) { %>
                                        <div class="alert alert-danger" role="alert">
                                            <%= mensagem.valor %>
                                        </div>
                                    <% } %>

                                    <form method="post" action="/perfilUsuario/perfil/<%= usuarioPerfil.id %>/comentarios"
                                        class="mural-card mural-comentario-form">
                                        <label for="comentarioMural">Deixe um comentário para <%= usuarioPerfil.nome %></label>
                                        <textarea id="comentarioMural" name="conteudo" class="mural-texto"
                                            maxlength="500" rows="4" placeholder="Escreva sua mensagem..."
                                            required></textarea>
                                        <button type="submit" class="botao-publicar botao-personalizado">
                                            <i class="bi bi-send"></i>
                                            Comentar
                                        </button>
                                    </form>

                                    <% if (comentarios.length === 0) { %>
                                        <p class="mural-texto">Ainda não há comentários neste mural.</p>
                                    <% } %>

                                    <% comentarios.forEach((comentario) => { %>
                                        <article class="mural-card">
                                            <div class="mural-topo">
                                                <% if (comentario.autor_imagem) { %>
                                                    <img src="/uploads/<%= comentario.autor_imagem %>"
                                                        class="padronizar-avatar-publi" alt="">
                                                <% } else { %>
                                                    <div class="mini-avatar">
                                                        <i class="bi bi-person"></i>
                                                    </div>
                                                <% } %>
                                                <div>
                                                    <strong><%= comentario.autor_nome %></strong>
                                                    <small><%= new Date(comentario.datahora).toLocaleString('pt-BR') %></small>
                                                </div>
                                            </div>
                                            <p class="mural-texto"><%= comentario.conteudo %></p>
                                        </article>
                                    <% }) %>
                                </div>
                            </div>
                        </div>
                </div>
                <%- include('../../partials/scripts') %>

                    <script>
                        const formularioBiografia = document.getElementById("formBiografia");
                        const entradaArquivo = document.getElementById("anexoUrl");
                        const nomeArquivo = document.getElementById("arquivoNome");
                        const previewBiografia = document.getElementById("previewBiografia");
                        let urlPreviewAtual = null;

                        if (entradaArquivo && nomeArquivo && previewBiografia) {
                            entradaArquivo.addEventListener("change", function () {
                                const arquivo = entradaArquivo.files[0];
                                if (urlPreviewAtual) {
                                    URL.revokeObjectURL(urlPreviewAtual);
                                    urlPreviewAtual = null;
                                }
                                previewBiografia.replaceChildren();
                                previewBiografia.style.display = "none";

                                if (!arquivo) {
                                    nomeArquivo.textContent = "Imagens, vídeos ou áudios (máximo 10 MB).";
                                    return;
                                }

                                if (arquivo.size > 10 * 1024 * 1024) {
                                    entradaArquivo.value = "";
                                    nomeArquivo.textContent = "O arquivo deve ter no máximo 10 MB.";
                                    return;
                                }

                                nomeArquivo.textContent = "Arquivo selecionado: " + arquivo.name;
                                urlPreviewAtual = URL.createObjectURL(arquivo);

                                let preview;
                                if (arquivo.type.startsWith("image/")) {
                                    preview = document.createElement("img");
                                    preview.alt = "Pré-visualização do arquivo";
                                } else if (arquivo.type.startsWith("video/")) {
                                    preview = document.createElement("video");
                                    preview.controls = true;
                                } else if (arquivo.type.startsWith("audio/")) {
                                    preview = document.createElement("audio");
                                    preview.controls = true;
                                }

                                if (preview) {
                                    preview.src = urlPreviewAtual;
                                    previewBiografia.appendChild(preview);
                                    previewBiografia.style.display = "block";
                                }
                            });
                        }

                        if (formularioBiografia) {
                            formularioBiografia.addEventListener("submit", function (event) {
                                const texto = document.getElementById("textoBiografia").value.trim();
                                if (!texto && !(entradaArquivo && entradaArquivo.files.length)) {
                                    event.preventDefault();
                                    alert("Escreva uma mensagem ou escolha um arquivo.");
                                }
                            });
                        }

                        /* ABAS */

                        function mostrarAba(nome, botao) {


                            const secoes =
                                document.querySelectorAll(
                                    ".perfil-section"
                                );


                            const botoes =
                                document.querySelectorAll(
                                    ".perfil-tab"
                                );


                            secoes.forEach(function (secao) {

                                secao.classList.remove(
                                    "active"
                                );

                            });


                            botoes.forEach(function (
                                botaoAtual
                            ) {

                                botaoAtual.classList.remove(
                                    "active"
                                );

                            });


                            document
                                .getElementById(nome)
                                .classList.add("active");


                            botao.classList.add("active");

                        }



                        /* CURTIR */

                        function curtir(botao) {


                            const icone =
                                botao.querySelector("i");


                            if (
                                icone.classList.contains(
                                    "bi-heart"
                                )
                            ) {

                                icone.classList.remove(
                                    "bi-heart"
                                );

                                icone.classList.add(
                                    "bi-heart-fill"
                                );

                                botao.style.color =
                                    "#6840b5";

                            } else {

                                icone.classList.remove(
                                    "bi-heart-fill"
                                );

                                icone.classList.add(
                                    "bi-heart"
                                );

                                botao.style.color =
                                    "#666176";

                            }

                        }

                    </script>

        </body>

</html>