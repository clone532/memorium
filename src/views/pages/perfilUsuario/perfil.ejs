<!DOCTYPE html>
<html lang="pt-br">
<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Perfil - Memorium</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --perfil-bg: #fff;
            --perfil-primary: #6840b5;
            --perfil-primary-hover: #552e9d;
            --perfil-accent: #e8e1ff;
            --perfil-accent-soft: #f2efff;
            --perfil-ink: #27243b;
            --perfil-muted: #777487;
            --perfil-border: #eeeaf7;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: var(--perfil-bg);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .perfil-layout {
            display: flex;
            flex: 1;
            min-height: 0;
        }

        .perfil-layout>.sidebar {
            flex: 0 0 250px;
            width: 250px;
            min-height: calc(100vh - 56px);
            overflow-y: auto;
            transition: margin-left 0.3s ease;
        }

        .perfil-layout>.sidebar.hidden {
            margin-left: -250px;
        }

        .perfil-layout>.sidebar .nav-link {
            border-radius: 6px;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .perfil-layout>.sidebar .nav-link:hover,
        .perfil-layout>.sidebar .nav-link:focus-visible {
            background-color: #51208f;
            color: #fff;
        }

        .perfil-container {
            flex: 1;
            min-width: 0;
            min-height: calc(100vh - 56px);
            background: var(--perfil-bg);
            padding: 40px 20px;
        }

        .perfil-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .perfil-avatar {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 0 auto 15px;
        }

        .perfil-avatar img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            display: none;
        }

        .avatar-padrao {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: var(--perfil-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .avatar-padrao i {
            color: #5d359d;
            font-size: 65px;
        }

        .botao-foto {
            position: absolute;
            right: -5px;
            bottom: -5px;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 3px solid white;
            background: var(--perfil-primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 18px;
        }

        .botao-foto:hover {
            background: var(--perfil-primary-hover);
        }

        .menu-foto {
            margin-top: 15px;
            display: none;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .menu-foto button {
            border: none;
            border-radius: 20px;
            padding: 8px 18px;
            cursor: pointer;
            font-size: 14px;
        }

        .editar-foto {
            background: var(--perfil-primary);
            color: white;
        }

        .remover-foto {
            border: 1px solid #d8d2e9;
            background: #fff;
            color: #5d5570;
        }

        .perfil-name {
            font-size: 32px;
            color: var(--perfil-ink);
            margin: 20px 0 15px;
            font-weight: 600;
        }

        .perfil-divider {
            width: 80%;
            height: 3px;
            background: linear-gradient(90deg,
                    transparent,
                    #8d68d2,
                    transparent);
            margin: 30px auto;
        }

        .perfil-tabs {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .perfil-tab {
            padding: 12px 45px;
            border: none;
            border-radius: 25px;
            background: var(--perfil-accent-soft);
            color: #5d5570;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
        }

        .perfil-tab:hover {
            background: var(--perfil-accent);
            color: var(--perfil-primary-hover);
            transform: translateY(-2px);
        }

        .perfil-tab.active {
            background: var(--perfil-primary);
            color: #fff;
            box-shadow: 0 4px 15px rgba(104, 64, 181, 0.2);
        }

        .perfil-content {
            max-width: 900px;
            margin: auto;
        }

        .perfil-section {
            display: none;
            animation: aparecer 0.3s ease;
        }

        .perfil-section.active {
            display: block;
        }

        .perfil-section h2 {
            color: var(--perfil-ink);
            margin-bottom: 20px;
        }

        /* CRIAR PUBLICAÇÃO */

        .criar-publicacao {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .criar-publicacao h3 {
            color: var(--perfil-ink);
            font-size: 21px;
            margin-bottom: 18px;
        }

        .campo-publicacao {
            width: 100%;
            min-height: 100px;
            border: 1px solid #d8d2e9;
            border-radius: 12px;
            padding: 15px;
            resize: vertical;
            outline: none;
            font-size: 15px;
        }

        .campo-publicacao:focus {
            border-color: #8d68d2;
        }

        .opcoes-publicacao {
            display: flex;
            gap: 10px;
            margin-top: 15px;
            flex-wrap: wrap;
        }

        .opcao-arquivo {
            border: none;
            background: var(--perfil-accent-soft);
            color: var(--perfil-primary);
            padding: 10px 16px;
            border-radius: 20px;
            cursor: pointer;
        }

        .opcao-arquivo:hover {
            background: var(--perfil-accent);
        }

        .arquivo-nome {
            color: var(--perfil-muted);
            font-size: 14px;
            margin-top: 10px;
        }

        .preview-publicacao {
            margin-top: 15px;
            display: none;
        }

        .preview-publicacao img,
        .preview-publicacao video {
            max-width: 100%;
            max-height: 400px;
            border-radius: 12px;
        }

        .botao-publicar {
            margin-top: 15px;
            width: 100%;
            border: none;
            background: var(--perfil-primary);
            color: white;
            padding: 12px;
            border-radius: 25px;
            font-size: 16px;
            cursor: pointer;
        }

        .botao-publicar:hover {
            background: var(--perfil-primary-hover);
        }

        /* PUBLICAÇÕES */

        .publicacao {
            background: white;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .publicacao-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 15px;
        }

        .mini-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: var(--perfil-accent);
            color: #5d359d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
            flex-shrink: 0;
            overflow: hidden;
        }

        .mini-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
        }

        .publicacao-header strong {
            display: block;
            color: var(--perfil-ink);
        }

        .publicacao-header small {
            color: var(--perfil-muted);
        }

        .publicacao p {
            color: #39364c;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .publicacao-media {
            width: 100%;
            max-height: 500px;
            object-fit: contain;
            border-radius: 12px;
            margin-bottom: 15px;
            background: #f5f3fc;
        }

        .publicacao-acoes {
            border-top: 1px solid var(--perfil-border);
            padding-top: 12px;
            display: flex;
            gap: 20px;
        }

        .publicacao-acoes button {
            border: none;
            background: none;
            color: #666176;
            cursor: pointer;
        }

        .publicacao-acoes button:hover {
            color: var(--perfil-primary);
        }

        /* MURAL */

        .mural-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .mural-topo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .mural-topo strong {
            display: block;
            color: var(--perfil-ink);
        }

        .mural-topo small {
            color: var(--perfil-muted);
        }

        .mural-conteudo {
            background: var(--perfil-accent-soft);
            border-radius: 12px;
            padding: 20px;
        }

        .mural-conteudo p {
            color: #39364c;
            margin: 0;
            line-height: 1.6;
        }

        .mural-acoes {
            display: flex;
            gap: 20px;
            margin-top: 15px;
            padding-top: 12px;
            border-top: 1px solid var(--perfil-border);
        }

        .mural-acoes button {
            border: none;
            background: none;
            color: #666176;
            cursor: pointer;
        }

        .mural-acoes button:hover {
            color: var(--perfil-primary);
        }

        .mural-texto {
            color: #39364c;
            line-height: 1.6;
        }

        @keyframes aparecer {

            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }

        @media (max-width: 768px) {

            .perfil-container {
                padding: 30px 15px;
            }

            .perfil-name {
                font-size: 24px;
            }

            .perfil-tab {
                padding: 10px 30px;
                font-size: 14px;
            }

            .perfil-divider {
                width: 90%;
            }

        }
    </style>

</head>

<body>
    <%- include('../../partials/header') %>
        <div class="perfil-layout">
            <%- include('../../partials/sidebar') %>
                <div class="perfil-container">

                    <div class="perfil-header">


                        <!-- FOTO DO PERFIL -->

                        <div class="perfil-avatar">


                            <div id="avatarPadrao" class="avatar-padrao">

                                <i class="bi bi-person-circle"></i>

                            </div>


                            <img id="fotoPerfil" src="" alt="Foto de perfil">


                            <label for="inputFoto" class="botao-foto" title="Editar foto">

                                <i class="bi bi-camera"></i>

                            </label>


                            <input type="file" id="inputFoto" accept="image/*" style="display: none;">


                        </div>


                        <div id="menuFoto" class="menu-foto">


                            <button class="editar-foto" onclick="abrirFotos()">

                                <i class="bi bi-camera"></i>

                                Alterar foto

                            </button>


                            <button class="remover-foto" onclick="removerFoto()">

                                <i class="bi bi-trash"></i>

                                Remover foto

                            </button>


                        </div>


                        <h1 class="perfil-name">

                            <%= usuario.nome %>

                        </h1>


                        <div class="perfil-divider"></div>


                        <div class="perfil-tabs">


                            <button class="perfil-tab active" onclick="mostrarAba('publicacoes', this)">

                                Publicações

                            </button>


                            <button class="perfil-tab" onclick="mostrarAba('mural', this)">

                                Mural

                            </button>


                        </div>


                    </div>



                    <div class="perfil-content">


                        <!-- ============================= -->
                        <!-- PUBLICAÇÕES -->
                        <!-- ============================= -->

                        <div id="publicacoes" class="perfil-section active">


                            <h2>
                                Publicações
                            </h2>


                            <!-- CRIAR PUBLICAÇÃO -->

                                <% if (usuarioPerfil.imagem) { %>
                                <img src="/'BANCO DE ARQUIVOS'/<%=usuarioPerfil.imagem%>" class="rounded mb-3">
                                <% } %>

                                    <form id="formPublicacao" class="criar-publicacao" onsubmit="return publicar(event)"
                                        enctype="multipart/form-data">

                                        <h3>

                                            Criar publicação

                                        </h3>


                                        <textarea name="texto" id="textoPublicacao" class="campo-publicacao"
                                            placeholder="Compartilhe uma lembrança ou escreva algo..."></textarea>


                                        <div class="opcoes-publicacao">


                                            <label class="opcao-arquivo">

                                                <i class="bi bi-image"></i>

                                                Foto

                                                <input type="file" id="inputFotoPublicacao" name="arquivo"
                                                    accept="image/*" hidden>

                                            </label>


                                            <label class="opcao-arquivo">

                                                <i class="bi bi-camera-video"></i>

                                                Vídeo

                                                <input type="file" id="inputVideoPublicacao" name="arquivo"
                                                    accept="video/*" hidden>

                                            </label>


                                        </div>


                                        <div id="arquivoNome" class="arquivo-nome">

                                        </div>


                                        <div id="previewPublicacao" class="preview-publicacao">

                                        </div>


                                        <button type="submit" class="botao-publicar">

                                            <i class="bi bi-send"></i>

                                            Publicar

                                        </button>


                                    </form>


                                    <!-- LISTA DE PUBLICAÇÕES -->

                                    <div id="listaPublicacoes">


                                        <div class="publicacao">


                                            <div class="publicacao-header">


                                                <div class="mini-avatar">

                                                    <i class="bi bi-person"></i>

                                                </div>


                                                <div>

                                                    <strong>

                                                        <%= usuario.nome %>

                                                    </strong>

                                                    <small>

                                                        Hoje

                                                    </small>

                                                </div>


                                            </div>


                                            <p>

                                                Este é um espaço para compartilhar
                                                momentos e lembranças especiais.

                                            </p>


                                            <div class="publicacao-acoes">


                                                <button onclick="curtir(this)">

                                                    <i class="bi bi-heart"></i>

                                                    Curtir

                                                </button>


                                                <button>

                                                    <i class="bi bi-chat"></i>

                                                    Comentar

                                                </button>


                                            </div>


                                        </div>


                                    </div>


                        </div>



                        <!-- ============================= -->
                        <!-- MURAL -->
                        <!-- ============================= -->

                        <div id="mural" class="perfil-section">


                            <h2>
                                Mural
                            </h2>


                            <div class="mural-card">


                                <div class="mural-topo">


                                    <div class="mini-avatar">

                                        <i class="bi bi-person"></i>

                                    </div>


                                    <div>

                                        <strong>

                                            <%= usuario.nome %>

                                        </strong>

                                        <small>

                                            Seu mural

                                        </small>

                                    </div>


                                </div>


                                <div class="mural-conteudo">

                                    <p>

                                        Este é o seu mural.
                                        Aqui serão exibidas suas
                                        publicações e memórias.

                                    </p>

                                </div>


                                <div class="mural-acoes">


                                    <button onclick="curtir(this)">

                                        <i class="bi bi-heart"></i>

                                        Curtir

                                    </button>


                                    <button>

                                        <i class="bi bi-chat"></i>

                                        Comentar

                                    </button>


                                </div>


                            </div>


                            <div class="mural-card">


                                <div class="mural-topo">


                                    <div class="mini-avatar">

                                        <i class="bi bi-person"></i>

                                    </div>


                                    <div>

                                        <strong>

                                            <%= usuario.nome %>

                                        </strong>

                                        <small>

                                            Publicação

                                        </small>

                                    </div>


                                </div>


                                <p class="mural-texto">

                                    Aqui aparecerão os conteúdos
                                    publicados no mural.

                                </p>


                                <div class="mural-acoes">


                                    <button onclick="curtir(this)">

                                        <i class="bi bi-heart"></i>

                                        Curtir

                                    </button>


                                    <button>

                                        <i class="bi bi-chat"></i>

                                        Comentar

                                    </button>


                                </div>


                            </div>


                        </div>


                    </div>


                </div>
        </div>

        <%- include('../../partials/scripts') %>

            <script>


                let arquivoSelecionado = null;


                /* FOTO DE PERFIL */

                document
                    .querySelector(".botao-foto")
                    .addEventListener("click", function () {

                        const menu =
                            document.getElementById("menuFoto");

                        if (menu.style.display === "flex") {

                            menu.style.display = "none";

                        } else {

                            menu.style.display = "flex";

                        }

                    });


                function abrirFotos() {

                    document
                        .getElementById("inputFoto")
                        .click();

                }


                document
                    .getElementById("inputFoto")
                    .addEventListener("change", function (event) {

                        const arquivo =
                            event.target.files[0];

                        if (!arquivo) {
                            return;
                        }

                        if (!arquivo.type.startsWith("image/")) {

                            alert("Selecione uma imagem.");

                            return;

                        }

                        const leitor =
                            new FileReader();

                        leitor.onload = function (e) {

                            const foto =
                                document.getElementById("fotoPerfil");

                            const avatar =
                                document.getElementById("avatarPadrao");

                            foto.src =
                                e.target.result;

                            foto.style.display =
                                "block";

                            avatar.style.display =
                                "none";

                            document
                                .getElementById("menuFoto")
                                .style.display =
                                "none";

                        };

                        leitor.readAsDataURL(arquivo);

                    });


                function removerFoto() {

                    const foto =
                        document.getElementById("fotoPerfil");

                    const avatar =
                        document.getElementById("avatarPadrao");

                    foto.src = "";

                    foto.style.display =
                        "none";

                    avatar.style.display =
                        "flex";

                    document
                        .getElementById("inputFoto")
                        .value = "";

                    document
                        .getElementById("menuFoto")
                        .style.display =
                        "none";

                }



                /* FOTO DA PUBLICAÇÃO */

                document
                    .getElementById("inputFotoPublicacao")
                    .addEventListener("change", function (event) {

                        const arquivo =
                            event.target.files[0];

                        if (!arquivo) {
                            return;
                        }

                        arquivoSelecionado = arquivo;

                        document
                            .getElementById("inputVideoPublicacao")
                            .value = "";

                        mostrarPreview(arquivo);

                    });



                /* VÍDEO DA PUBLICAÇÃO */

                document
                    .getElementById("inputVideoPublicacao")
                    .addEventListener("change", function (event) {

                        const arquivo =
                            event.target.files[0];

                        if (!arquivo) {
                            return;
                        }

                        arquivoSelecionado = arquivo;

                        document
                            .getElementById("inputFotoPublicacao")
                            .value = "";

                        mostrarPreview(arquivo);

                    });



                /* PREVIEW */

                function mostrarPreview(arquivo) {

                    const preview =
                        document.getElementById(
                            "previewPublicacao"
                        );

                    const nome =
                        document.getElementById(
                            "arquivoNome"
                        );

                    const url =
                        URL.createObjectURL(arquivo);


                    nome.textContent =
                        "Arquivo selecionado: " +
                        arquivo.name;


                    preview.innerHTML = "";


                    if (
                        arquivo.type.startsWith("image/")
                    ) {

                        const imagem =
                            document.createElement("img");

                        imagem.src = url;

                        imagem.className =
                            "publicacao-media";

                        preview.appendChild(imagem);

                    }


                    if (
                        arquivo.type.startsWith("video/")
                    ) {

                        const video =
                            document.createElement("video");

                        video.src = url;

                        video.className =
                            "publicacao-media";

                        video.controls = true;

                        preview.appendChild(video);

                    }


                    preview.style.display =
                        "block";

                }



                /* PUBLICAR */

                function publicar() {


                    // If called as form submit, prevent default
                    const evt = arguments[0];
                    if (evt && typeof evt.preventDefault === 'function') evt.preventDefault();

                    const texto = document.getElementById('textoPublicacao').value.trim();

                    if (texto === '' && !arquivoSelecionado) {
                        alert('Escreva uma mensagem ou adicione uma foto/vídeo.');
                        return false;
                    }

                    const form = document.getElementById('formPublicacao');
                    const formData = new FormData(form);

                    // Ensure the currently selected file (if any) is appended
                    if (arquivoSelecionado) {
                        formData.set('arquivo', arquivoSelecionado);
                    }

                    // Send to server (no multer-specific formatting here; browser handles multipart)
                    fetch('/publicacoes', {
                        method: 'POST',
                        body: formData
                    }).catch(function (err) {
                        console.warn('Envio falhou (uso offline ou rota ausente):', err);
                    });

                    // Immediate local render for feedback (same behavior as before)
                    const lista = document.getElementById('listaPublicacoes');
                    const publicacao = document.createElement('div');
                    publicacao.className = 'publicacao';
                    const data = new Date().toLocaleDateString('pt-BR');
                    let conteudo = '';

                    if (texto !== '') conteudo += `<p>${texto}</p>`;

                    if (arquivoSelecionado) {
                        const url = URL.createObjectURL(arquivoSelecionado);
                        if (arquivoSelecionado.type.startsWith('image/')) {
                            conteudo += `<img src="${url}" class="publicacao-media">`;
                        }
                        if (arquivoSelecionado.type.startsWith('video/')) {
                            conteudo += `<video src="${url}" class="publicacao-media" controls></video>`;
                        }
                    }

                    publicacao.innerHTML = `
            <div class="publicacao-header">
                <div class="mini-avatar">
                    <i class="bi bi-person"></i>
                </div>
                <div>
                    <strong>
                        <%= usuario.nome %>
                    </strong>
                    <small>
                        ${data}
                    </small>
                </div>
            </div>
            ${conteudo}
            <div class="publicacao-acoes">
                <button onclick="curtir(this)">
                    <i class="bi bi-heart"></i>
                    Curtir
                </button>
                <button>
                    <i class="bi bi-chat"></i>
                    Comentar
                </button>
            </div>
        `;

                    lista.prepend(publicacao);

                    // Reset form and preview
                    form.reset();
                    document.getElementById('arquivoNome').textContent = '';
                    const preview = document.getElementById('previewPublicacao');
                    preview.innerHTML = '';
                    preview.style.display = 'none';
                    arquivoSelecionado = null;

                    return false;

                }



                /* ABAS */

                function mostrarAba(nome, botao) {


                    const secoes =
                        document.querySelectorAll(
                            ".perfil-section"
                        );


                    const botoes =
                        document.querySelectorAll(
                            ".perfil-tab"
                        );


                    secoes.forEach(function (secao) {

                        secao.classList.remove(
                            "active"
                        );

                    });


                    botoes.forEach(function (
                        botaoAtual
                    ) {

                        botaoAtual.classList.remove(
                            "active"
                        );

                    });


                    document
                        .getElementById(nome)
                        .classList.add("active");


                    botao.classList.add("active");

                }



                /* CURTIR */

                function curtir(botao) {


                    const icone =
                        botao.querySelector("i");


                    if (
                        icone.classList.contains(
                            "bi-heart"
                        )
                    ) {

                        icone.classList.remove(
                            "bi-heart"
                        );

                        icone.classList.add(
                            "bi-heart-fill"
                        );

                        botao.style.color =
                            "#6840b5";

                    } else {

                        icone.classList.remove(
                            "bi-heart-fill"
                        );

                        icone.classList.add(
                            "bi-heart"
                        );

                        botao.style.color =
                            "#666176";

                    }

                }

            </script>

</body>

</html>