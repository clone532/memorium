<!DOCTYPE html>
<html lang="pt-br">
<%- include('../../partials/head') %>
    <%- include('../../partials/formataçãoFormulario') %>

        <style>
            :root {
                --perfil-bg: #fff;
                --perfil-primary: #6840b5;
                --perfil-primary-hover: #552e9d;
                --perfil-accent: #e8e1ff;
                --perfil-accent-soft: #f2efff;
                --perfil-ink: #27243b;
                --perfil-muted: #777487;
                --perfil-border: #eeeaf7;
            }

            .reference {
                color: #000000;
            }

            .reference:hover {
                color: #6840b5;
            }

            * {
                box-sizing: border-box;
            }

            html {
                height: auto;
                min-height: 100%;
                overflow-y: auto;
            }

            .botao-personalizado {
                font-family: inherit;
                font-weight: 600;
                line-height: 1.2;
                transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
            }

            .botao-personalizado:focus-visible {
                outline: 3px solid rgba(104, 64, 181, 0.35);
                outline-offset: 2px;
            }

            .botao-personalizado:disabled {
                cursor: not-allowed;
                opacity: 0.6;
            }

            body {
                margin: 0;
                height: auto;
                min-height: 100vh;
                overflow: visible;
                font-family: Arial, sans-serif;
                background: var(--perfil-bg);
                display: flex;
                flex-direction: column;
            }

            .padronizar-avatar {
                border-radius: 50%;
                width: 120px;
                height: 120px;
                background: var(--perfil-accent);
                object-fit: cover;
                flex-shrink: 0;
            }

            .padronizar-avatar-publi {
                border-radius: 50%;
                width: 30px;
                height: 30px;
                background: var(--perfil-accent);
                object-fit: cover;
                flex-shrink: 0;
            }

            .padronizar-avatar.bi-person-circle {
                font-size: 120px;
                line-height: 1;
            }

            .perfil-layout {
                display: flex;
                min-height: 0;
            }

            body>.perfil-layout {
                flex: 0 0 auto;
                overflow: visible;
            }

            .perfil-layout>.sidebar {
                position: sticky;
                top: 0;
                align-self: flex-start;
                height: 100vh;
                min-height: 0;
                overflow-y: auto;
            }

            .perfil-container {
                flex: 1;
                min-width: 0;
                min-height: calc(100vh - 56px);
                background: var(--perfil-bg);
                padding: 40px 20px;
            }

            .perfil-header {
                text-align: center;
                margin-bottom: 40px;
            }

            .botao-foto {
                position: absolute;
                right: -5px;
                bottom: -5px;
                width: 40px;
                height: 40px;
                border-radius: 50%;
                border: 3px solid white;
                background: var(--perfil-primary);
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                font-size: 18px;
            }

            .perfil-name {
                font-size: 32px;
                color: var(--perfil-ink);
                margin: 20px 0 15px;
                font-weight: 600;
            }

            .perfil-divider {
                width: 80%;
                height: 3px;
                background: linear-gradient(90deg,
                        transparent,
                        #8d68d2,
                        transparent);
                margin: 30px auto;
            }

            .perfil-tabs {
                display: flex;
                justify-content: center;
                gap: 20px;
                flex-wrap: wrap;
            }

            .perfil-tab {
                padding: 12px 45px;
                border: none;
                border-radius: 25px;
                background: var(--perfil-accent-soft);
                color: #5d5570;
                font-size: 16px;
                cursor: pointer;
                transition: 0.3s;
            }

            .perfil-tab:hover {
                background: var(--perfil-accent);
                color: var(--perfil-primary-hover);
                transform: translateY(-2px);
            }

            .perfil-tab.active {
                background: var(--perfil-primary);
                color: #fff;
                box-shadow: 0 4px 15px rgba(104, 64, 181, 0.2);
            }

            .perfil-content {
                max-width: 900px;
                margin: auto;
            }

            .perfil-section {
                display: none;
                animation: aparecer 0.3s ease;
            }

            .perfil-section.active {
                display: block;
            }

            .perfil-section h2 {
                color: var(--perfil-ink);
                margin-bottom: 20px;
            }
            
            .criar-biografia {
                background: transparent;
                border-radius: 15px;
                padding: 0;
                margin-bottom: 25px;
            }

            .campo-biografia {
                width: 100%;
                min-height: 100px;
                border: 1px solid #d8d2e9;
                border-radius: 12px;
                padding: 15px;
                resize: vertical;
                outline: none;
                font-size: 15px;
                box-sizing: border-box;
                background: white;
            }

            .campo-biografia:focus {
                border-color: #8d68d2;
                box-shadow: 0 0 0 3px rgba(141, 104, 210, 0.12);
            }

            .opcoes-biografia {
                display: flex;
                gap: 10px;
                margin-top: 15px;
                flex-wrap: wrap;
            }

            .opcao-arquivo {
                border: none;
                background: var(--perfil-accent-soft);
                color: var(--perfil-primary);
                padding: 10px 16px;
                border-radius: 20px;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-weight: 600;
            }

            .opcao-arquivo:hover {
                background: var(--perfil-accent);
            }

            .arquivo-nome {
                color: var(--perfil-muted);
                font-size: 14px;
                margin-top: 10px;
            }

            .preview-publicacao {
                margin-top: 15px;
                display: none;
            }

            .preview-publicacao img,
            .preview-publicacao video {
                max-width: 100%;
                max-height: 400px;
                border-radius: 12px;
            }

            .botao-publicar {
                margin-top: 15px;
                width: 100%;
                border: none;
                background: var(--perfil-primary);
                color: white;
                padding: 12px;
                border-radius: 25px;
                font-size: 16px;
                cursor: pointer;
            }

            .botao-publicar:hover {
                background: var(--perfil-primary-hover);
            }

            /* PUBLICAÇÕES */

            .publicacao {
                background: white;
                border-radius: 15px;
                padding: 20px;
                margin-bottom: 20px;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            }

            .publicacao-header {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 15px;
            }

            .mini-avatar {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: var(--perfil-accent);
                color: #5d359d;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                flex-shrink: 0;
                overflow: hidden;
            }

            .mini-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: none;
            }

            .publicacao-header strong {
                display: block;
                color: var(--perfil-ink);
            }

            .publicacao-header small {
                color: var(--perfil-muted);
            }

            .publicacao p {
                color: #39364c;
                line-height: 1.6;
                margin-bottom: 15px;
            }

            .publicacao-media {
                width: 100%;
                max-height: 500px;
                object-fit: contain;
                border-radius: 12px;
                margin-bottom: 15px;
                background: #f5f3fc;
            }

            .publicacao-acoes {
                border-top: 1px solid var(--perfil-border);
                padding-top: 12px;
                display: flex;
                gap: 20px;
            }

            .botao-personalizado--acao {
                border: none;
                background: none;
                color: #666176;
                padding: 6px 10px;
                border-radius: 8px;
                cursor: pointer;
            }

            .botao-personalizado--acao:hover {
                background: var(--perfil-accent-soft);
                color: var(--perfil-primary);
            }

            /* MURAL */

            .mural-card {
                background: white;
                border-radius: 15px;
                padding: 20px;
                margin-bottom: 20px;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            }

            .mural-topo {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 20px;
            }

            .mural-topo strong {
                display: block;
                color: var(--perfil-ink);
            }

            .mural-topo small {
                color: var(--perfil-muted);
            }

            .mural-conteudo {
                background: var(--perfil-accent-soft);
                border-radius: 12px;
                padding: 20px;
            }

            .mural-conteudo p {
                color: #39364c;
                margin: 0;
                line-height: 1.6;
            }

            .mural-acoes {
                display: flex;
                gap: 20px;
                margin-top: 15px;
                padding-top: 12px;
                border-top: 1px solid var(--perfil-border);
            }

            .mural-texto {
                color: #39364c;
                line-height: 1.6;
            }

            @keyframes aparecer {

                from {
                    opacity: 0;
                    transform: translateY(10px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }

            }

            @media (max-width: 768px) {

                .perfil-container {
                    padding: 30px 15px;
                }

                .perfil-name {
                    font-size: 24px;
                }

                .perfil-tab {
                    padding: 10px 30px;
                    font-size: 14px;
                }

                .perfil-divider {
                    width: 90%;
                }

            }
        </style>

        <body>
            <%- include('../../partials/header') %>
                <div class="perfil-layout">
                    <%- include('../../partials/sidebar') %>
                        <div class="perfil-container">
                            <div class="perfil-header">

                                <div class="d-flex justify-content-center">
                                    <% if (usuarioPerfil.imagem) { %>
                                        <img src="/uploads/<%= usuarioPerfil.imagem %>" class="padronizar-avatar">
                                        <% } else { %>
                                            <i class="bi bi-person-circle padronizar-avatar" aria-hidden="true"
                                                id="fotoPerfil"></i>
                                            <% } %>
                                </div>
                                <h1 class="perfil-name">
                                    <%= usuario.nome %>
                                </h1>
                                <a href="/usuario/configuracaoPerfil" class="reference"><i class="bi bi-gear"></i>
                                    <button class="btn botao-personalizado" type="button">
                                        configurações
                                    </button>
                                </a>

                                <div class="perfil-divider"></div>
                                <div class="perfil-tabs">
                                    <button class="perfil-tab botao-personalizado active"
                                        onclick="mostrarAba('biografia', this)">
                                        Biografia
                                    </button>
                                    <button class="perfil-tab botao-personalizado" onclick="mostrarAba('mural', this)">
                                        Mural
                                    </button>
                                </div>
                            </div>

                            <div class="perfil-content">
                                <div id="biografia" class="perfil-section active">
                                    <h2>
                                        Biografia
                                    </h2>

                                    <!-- CRIAR PUBLICAÇÃO -->
                                    <form id="formBiografia" class="criar-biografia" onsubmit="return publicar(event)"
                                        enctype="multipart/form-data">
                                        <h3>
                                            <% if (usuario.imagem) { %>
                                                <img src="/uploads/<%= usuario.imagem %>"
                                                    class="padronizar-avatar-publi">
                                                <% } else { %>
                                                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                                                    <% } %>
                                                        Criar publicação
                                        </h3>
                                        <textarea name="texto" id="textobiografia" class="campo-biografia"
                                            placeholder="Compartilhe uma lembrança ou escreva algo..."></textarea>

                                        <div class="opcoes-biografia">
                                            <label class="opcao-arquivo">
                                                <i class="bi bi-image"></i>
                                                arquivo
                                                <input type="file" id="anexoUrl" name="anexoUrl" accept="image/*,video/*,audio/*">
                                            </label>
                                        </div>
                                        <div id="arquivoNome" class="arquivo-nome">
                                        </div>

                                        <div id="previewBiografia" class="preview-biografia">
                                        </div>
                                        <button type="submit" class="botao-publicar botao-personalizado">
                                            <i class="bi bi-send"></i>
                                            Publicar
                                        </button>
                                    </form>


                                    <!-- LISTA DE PUBLICAÇÕES -->
                                    <div id="listaBiografia">
                                        <div class="biografia">
                                            <div class="biografia-header">
                                                <div class="mini-avatar">
                                                    <i class="bi bi-person"></i>
                                                </div>
                                                <div>
                                                    <strong>
                                                        ADMIN
                                                    </strong>
                                                    <small>
                                                        Muito tempo atrás
                                                    </small>
                                                </div>
                                            </div>
                                            <p>
                                                Este é um espaço para compartilhar
                                                momentos e lembranças especiais.
                                            </p>
                                            <div class="biografia-acoes">
                                                <button class="botao-personalizado botao-personalizado--acao"
                                                    onclick="curtir(this)">
                                                    <i class="bi bi-heart"></i>
                                                    Curtir
                                                </button>
                                                <button class="botao-personalizado botao-personalizado--acao">
                                                    <i class="bi bi-chat"></i>
                                                    Comentar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>



                                <!-- ============================= -->
                                <!-- MURAL -->
                                <!-- ============================= -->

                                <div id="mural" class="perfil-section">

                                    <h2>
                                        Mural
                                    </h2>
                                    <div class="mural-card">
                                        <div class="mural-topo">
                                            <div class="mini-avatar">
                                                <i class="bi bi-person"></i>
                                            </div>
                                            <div>
                                                <strong>
                                                    <%= usuario.nome %>
                                                </strong>
                                                <small>
                                                    Seu mural
                                                </small>
                                            </div>
                                        </div>
                                        <div class="mural-conteudo">
                                            <p>
                                                Este é o seu mural.
                                                Aqui serão exibidas suas
                                                publicações e memórias.
                                            </p>
                                        </div>
                                        <div class="mural-acoes">
                                            <button class="botao-personalizado botao-personalizado--acao"
                                                onclick="curtir(this)">
                                                <i class="bi bi-heart"></i>
                                                Curtir
                                            </button>
                                            <button class="botao-personalizado botao-personalizado--acao">
                                                <i class="bi bi-chat"></i>
                                                Comentar
                                            </button>
                                        </div>
                                    </div>
                                    <div class="mural-card">
                                        <div class="mural-topo">
                                            <div class="mini-avatar">
                                                <i class="bi bi-person"></i>
                                            </div>
                                            <div>
                                                <strong>
                                                    <%= usuario.nome %>
                                                </strong>
                                                <small>
                                                    Publicação
                                                </small>
                                            </div>
                                        </div>
                                        <p class="mural-texto">
                                            Aqui aparecerão os conteúdos
                                            publicados no mural.
                                        </p>
                                        <div class="mural-acoes">
                                            <button class="botao-personalizado botao-personalizado--acao"
                                                onclick="curtir(this)">
                                                <i class="bi bi-heart"></i>
                                                Curtir
                                            </button>
                                            <button class="botao-personalizado botao-personalizado--acao">
                                                <i class="bi bi-chat"></i>
                                                Comentar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>
                <%- include('../../partials/scripts') %>

                    <script>
                        /* FOTO DA PUBLICAÇÃO */

                        document
                            .getElementById("inputFotoPublicacao")
                            .addEventListener("change", function (event) {
                                const arquivo =
                                    event.target.files[0];
                                if (!arquivo) {
                                    return;
                                }
                                arquivoSelecionado = arquivo;
                                document
                                    .getElementById("inputVideoPublicacao")
                                    .value = "";
                                mostrarPreview(arquivo);
                            });

                        /* VÍDEO DA PUBLICAÇÃO */
                        document
                            .getElementById("inputVideoPublicacao")
                            .addEventListener("change", function (event) {
                                const arquivo =
                                    event.target.files[0];
                                if (!arquivo) {
                                    return;
                                }
                                arquivoSelecionado = arquivo;
                                document
                                    .getElementById("inputFotoPublicacao")
                                    .value = "";
                                mostrarPreview(arquivo);
                            });

                        /* PREVIEW */
                        function mostrarPreview(arquivo) {
                            const preview =
                                document.getElementById(
                                    "previewPublicacao"
                                );
                            const nome =
                                document.getElementById(
                                    "arquivoNome"
                                );
                            const url =
                                URL.createObjectURL(arquivo);
                            nome.textContent =
                                "Arquivo selecionado: " +
                                arquivo.name;
                            preview.innerHTML = "";
                            if (
                                arquivo.type.startsWith("image/")
                            ) {
                                const imagem =
                                    document.createElement("img");
                                imagem.src = url;
                                imagem.className =
                                    "publicacao-media";
                                preview.appendChild(imagem);
                            }
                            if (
                                arquivo.type.startsWith("video/")
                            ) {
                                const video =
                                    document.createElement("video");
                                video.src = url;
                                video.className =
                                    "publicacao-media";
                                video.controls = true;
                                preview.appendChild(video);
                            }
                            preview.style.display =
                                "block";
                        }



                        /* PUBLICAR */
                        function publicar() {
                            const evt = arguments[0];
                            if (evt && typeof evt.preventDefault === 'function') evt.preventDefault();
                            const texto = document.getElementById('textoPublicacao').value.trim();
                            if (texto === '' && !arquivoSelecionado) {
                                alert('Escreva uma mensagem ou adicione uma foto/vídeo.');
                                return false;
                            }
                            const form = document.getElementById('formPublicacao');
                            const formData = new FormData(form);
                            if (arquivoSelecionado) {
                                formData.set('arquivo', arquivoSelecionado);
                            }
                            fetch('/publicacoes', {
                                method: 'POST',
                                body: formData
                            }).catch(function (err) {
                                console.warn('Envio falhou (uso offline ou rota ausente):', err);
                            });
                            const lista = document.getElementById('listaPublicacoes');
                            const publicacao = document.createElement('div');
                            publicacao.className = 'publicacao';
                            const data = new Date().toLocaleDateString('pt-BR');
                            let conteudo = '';
                            if (texto !== '') conteudo += `<p>${texto}</p>`;
                            if (arquivoSelecionado) {
                                const url = URL.createObjectURL(arquivoSelecionado);
                                if (arquivoSelecionado.type.startsWith('image/')) {
                                    conteudo += `<img src="${url}" class="publicacao-media">`;
                                }
                                if (arquivoSelecionado.type.startsWith('video/')) {
                                    conteudo += `<video src="${url}" class="publicacao-media" controls></video>`;
                                }
                            }

                            publicacao.innerHTML = `
            <div class="publicacao-header">
                <div class="mini-avatar">
                    <i class="bi bi-person"></i>
                </div>
                <div>
                    <strong>
                        <%= usuario.nome %>
                    </strong>
                    <small>
                        ${data}
                    </small>
                </div>
            </div>
            ${conteudo}
            <div class="publicacao-acoes">
                <button class="botao-personalizado botao-personalizado--acao" onclick="curtir(this)">
                    <i class="bi bi-heart"></i>
                    Curtir
                </button>
                <button class="botao-personalizado botao-personalizado--acao">
                    <i class="bi bi-chat"></i>
                    Comentar
                </button>
            </div>
        `;

                            lista.prepend(publicacao);

                            // Reset form and preview
                            form.reset();
                            document.getElementById('arquivoNome').textContent = '';
                            const preview = document.getElementById('previewPublicacao');
                            preview.innerHTML = '';
                            preview.style.display = 'none';
                            arquivoSelecionado = null;

                            return false;

                        }



                        /* ABAS */

                        function mostrarAba(nome, botao) {


                            const secoes =
                                document.querySelectorAll(
                                    ".perfil-section"
                                );


                            const botoes =
                                document.querySelectorAll(
                                    ".perfil-tab"
                                );


                            secoes.forEach(function (secao) {

                                secao.classList.remove(
                                    "active"
                                );

                            });


                            botoes.forEach(function (
                                botaoAtual
                            ) {

                                botaoAtual.classList.remove(
                                    "active"
                                );

                            });


                            document
                                .getElementById(nome)
                                .classList.add("active");


                            botao.classList.add("active");

                        }



                        /* CURTIR */

                        function curtir(botao) {


                            const icone =
                                botao.querySelector("i");


                            if (
                                icone.classList.contains(
                                    "bi-heart"
                                )
                            ) {

                                icone.classList.remove(
                                    "bi-heart"
                                );

                                icone.classList.add(
                                    "bi-heart-fill"
                                );

                                botao.style.color =
                                    "#6840b5";

                            } else {

                                icone.classList.remove(
                                    "bi-heart-fill"
                                );

                                icone.classList.add(
                                    "bi-heart"
                                );

                                botao.style.color =
                                    "#666176";

                            }

                        }

                    </script>

        </body>

</html>