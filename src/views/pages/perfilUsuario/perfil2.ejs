<!DOCTYPE html>
<html lang="pt-br">
    <%- include('../../partials/head') %>
    <%- include('../../partials/formataçãoFormulario') %>

    <style>
        :root {
            --perfil-bg: #fff;
            --perfil-primary: #6840b5;
            --perfil-primary-hover: #552e9d;
            --perfil-accent: #e8e1ff;
            --perfil-accent-soft: #f2efff;
            --perfil-ink: #27243b;
            --perfil-muted: #777487;
            --perfil-border: #eeeaf7;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: var(--perfil-bg);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .perfil-layout {
            display: flex;
            flex: 1;
            min-height: 0;
        }

        .perfil-layout>.sidebar {
            flex: 0 0 250px;
            width: 250px;
            min-height: calc(100vh - 56px);
            overflow-y: auto;
            transition: margin-left 0.3s ease;
        }

        .perfil-layout>.sidebar.hidden {
            margin-left: -250px;
        }

        .perfil-layout>.sidebar .nav-link {
            border-radius: 6px;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .perfil-layout>.sidebar .nav-link:hover,
        .perfil-layout>.sidebar .nav-link:focus-visible {
            background-color: #51208f;
            color: #fff;
        }

        .perfil-container {
            flex: 1;
            min-width: 0;
            min-height: calc(100vh - 56px);
            background: var(--perfil-bg);
            padding: 40px 20px;
        }

        .perfil-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .perfil-avatar {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 0 auto 15px;
        }

        .perfil-avatar img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            display: none;
        }

        .avatar-padrao {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: var(--perfil-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .avatar-padrao i {
            color: #5d359d;
            font-size: 65px;
        }

        .botao-foto {
            position: absolute;
            right: -5px;
            bottom: -5px;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 3px solid white;
            background: var(--perfil-primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 18px;
        }

        .botao-foto:hover {
            background: var(--perfil-primary-hover);
        }

        .menu-foto {
            margin-top: 15px;
            display: none;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .menu-foto button {
            border: none;
            border-radius: 20px;
            padding: 8px 18px;
            cursor: pointer;
            font-size: 14px;
        }

        .editar-foto {
            background: var(--perfil-primary);
            color: white;
        }

        .remover-foto {
            border: 1px solid #d8d2e9;
            background: #fff;
            color: #5d5570;
        }

        .perfil-name {
            font-size: 32px;
            color: var(--perfil-ink);
            margin: 20px 0 15px;
            font-weight: 600;
        }

        .perfil-divider {
            width: 80%;
            height: 3px;
            background: linear-gradient(90deg,
                    transparent,
                    #8d68d2,
                    transparent);
            margin: 30px auto;
        }

        .perfil-tabs {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .perfil-tab {
            padding: 12px 45px;
            border: none;
            border-radius: 25px;
            background: var(--perfil-accent-soft);
            color: #5d5570;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
        }

        .perfil-tab:hover {
            background: var(--perfil-accent);
            color: var(--perfil-primary-hover);
            transform: translateY(-2px);
        }

        .perfil-tab.active {
            background: var(--perfil-primary);
            color: #fff;
            box-shadow: 0 4px 15px rgba(104, 64, 181, 0.2);
        }

        .perfil-content {
            max-width: 900px;
            margin: auto;
        }

        .perfil-section {
            display: none;
            animation: aparecer 0.3s ease;
        }

        .perfil-section.active {
            display: block;
        }

        .perfil-section h2 {
            color: var(--perfil-ink);
            margin-bottom: 20px;
        }

        /* CRIAR PUBLICAÇÃO */

        .criar-publicacao {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .criar-publicacao h3 {
            color: var(--perfil-ink);
            font-size: 21px;
            margin-bottom: 18px;
        }

        .campo-publicacao {
            width: 100%;
            min-height: 100px;
            border: 1px solid #d8d2e9;
            border-radius: 12px;
            padding: 15px;
            resize: vertical;
            outline: none;
            font-size: 15px;
        }

        .campo-publicacao:focus {
            border-color: #8d68d2;
        }

        .opcoes-publicacao {
            display: flex;
            gap: 10px;
            margin-top: 15px;
            flex-wrap: wrap;
        }

        .opcao-arquivo {
            border: none;
            background: var(--perfil-accent-soft);
            color: var(--perfil-primary);
            padding: 10px 16px;
            border-radius: 20px;
            cursor: pointer;
        }

        .opcao-arquivo:hover {
            background: var(--perfil-accent);
        }

        .arquivo-nome {
            color: var(--perfil-muted);
            font-size: 14px;
            margin-top: 10px;
        }

        .preview-publicacao {
            margin-top: 15px;
            display: none;
        }

        .preview-publicacao img,
        .preview-publicacao video {
            max-width: 100%;
            max-height: 400px;
            border-radius: 12px;
        }

        .botao-publicar {
            margin-top: 15px;
            width: 100%;
            border: none;
            background: var(--perfil-primary);
            color: white;
            padding: 12px;
            border-radius: 25px;
            font-size: 16px;
            cursor: pointer;
        }

        .botao-publicar:hover {
            background: var(--perfil-primary-hover);
        }

        /* PUBLICAÇÕES */

        .publicacao {
            background: white;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .publicacao-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 15px;
        }

        .mini-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: var(--perfil-accent);
            color: #5d359d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
            flex-shrink: 0;
            overflow: hidden;
        }

        .mini-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
        }

        .publicacao-header strong {
            display: block;
            color: var(--perfil-ink);
        }

        .publicacao-header small {
            color: var(--perfil-muted);
        }

        .publicacao p {
            color: #39364c;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .publicacao-media {
            width: 100%;
            max-height: 500px;
            object-fit: contain;
            border-radius: 12px;
            margin-bottom: 15px;
            background: #f5f3fc;
        }

        .publicacao-acoes {
            border-top: 1px solid var(--perfil-border);
            padding-top: 12px;
            display: flex;
            gap: 20px;
        }

        .publicacao-acoes button {
            border: none;
            background: none;
            color: #666176;
            cursor: pointer;
        }

        .publicacao-acoes button:hover {
            color: var(--perfil-primary);
        }

        /* MURAL */

        .mural-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .mural-topo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .mural-topo strong {
            display: block;
            color: var(--perfil-ink);
        }

        .mural-topo small {
            color: var(--perfil-muted);
        }

        .mural-conteudo {
            background: var(--perfil-accent-soft);
            border-radius: 12px;
            padding: 20px;
        }

        .mural-conteudo p {
            color: #39364c;
            margin: 0;
            line-height: 1.6;
        }

        .mural-acoes {
            display: flex;
            gap: 20px;
            margin-top: 15px;
            padding-top: 12px;
            border-top: 1px solid var(--perfil-border);
        }

        .mural-acoes button {
            border: none;
            background: none;
            color: #666176;
            cursor: pointer;
        }

        .mural-acoes button:hover {
            color: var(--perfil-primary);
        }

        .mural-texto {
            color: #39364c;
            line-height: 1.6;
        }

        @keyframes aparecer {

            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }

        @media (max-width: 768px) {

            .perfil-container {
                padding: 30px 15px;
            }

            .perfil-name {
                font-size: 24px;
            }

            .perfil-tab {
                padding: 10px 30px;
                font-size: 14px;
            }

            .perfil-divider {
                width: 90%;
            }

        }
    </style>

<body class="bg-light">
    <%- include('../../partials/header') %>
      <div class="d-flex">
        <%- include('../../partials/sidebar') %>

          <div class="content">
            <h1>Perfil</h1>

            <% if (usuarioPerfil.imagem) { %>
                <img src="/uploads/<%= usuarioPerfil.imagem %>" class="perfil-avatar mb-3">
            <% } %>
            <form action="/usuario/perfil" method="post" enctype="multipart/form-data">
              <div class="row">
                <div class="form-group mb-3 col-lg-6 col-md-8 col-12">
                  <label for="nome">Nome</label>
                  <input class="form-control" type="text" name="nome" id="nome" value="<%= usuarioPerfil.nome %>">
                </div>
              </div>

              <div class="row">
                <div class="form-group mb-3 col-lg-6 col-md-8 col-12">
                  <label for="email">Email</label>
                  <input class="form-control" type="email" name="email" id="email" value="<%= usuarioPerfil.email %>">
                </div>
              </div>

              <div class="row">
                <div class="form-group mb-3 col-lg-6 col-md-8 col-12">
                  <label for="senha">Senha</label>
                  <input class="form-control" type="password" name="senha" id="senha" value="<%= usuarioPerfil.senha %>">
                </div>
              </div>

              <div class="row">
                <div class="form-group mb-3 col-lg-6 col-md-8 col-12">
                  <label for="imagem">Imagem</label>
                  <input class="form-control" 
                  type="file" 
                  name="imagem" 
                  id="imagem" accept="image/*">
                </div>
              </div>
              <button type="submit" class="btn btn-primary mt-1">Salvar</button>
            </form>
          </div>
      </div>

      <%- include('../../partials/scripts') %>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <% if (mensagem) { %>

          <script>
            Swal.fire({
              backdrop: false,
              icon: '<%= mensagem.tipo %>',
              text: '<%= mensagem.valor %>'
            });
          </script>

          <% } %>
  </body>


</html>